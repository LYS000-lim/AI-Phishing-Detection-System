# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored - never commit real credentials.

# --- Password reset emails (Gmail SMTP) ---
# 1. Enable 2-Step Verification on the sending Gmail account:
#    https://myaccount.google.com/security
# 2. Create an App Password:
#    https://myaccount.google.com/apppasswords
#    (Regular Gmail passwords do NOT work with SMTP - it must be an App Password.)
# 3. Fill in the values below with that Gmail address + the 16-character App Password.
PHISHGUARD_SMTP_HOST=smtp.gmail.com
PHISHGUARD_SMTP_PORT=587
PHISHGUARD_SMTP_USER=your-address@gmail.com
PHISHGUARD_SMTP_PASSWORD=xxxxxxxxxxxxxxxx
PHISHGUARD_SMTP_FROM=your-address@gmail.com

# --- Other settings (optional overrides) ---
# PHISHGUARD_SECRET=change-me-in-production
# PHISHGUARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# PHISHGUARD_FRONTEND_URL=http://localhost:5173
