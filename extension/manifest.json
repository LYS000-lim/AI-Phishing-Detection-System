{
  "manifest_version": 3,

  "name": "PhishGuard AI",

  "version": "1.0.0",

  "description": "AI-powered phishing website detection using Random Forest model",

  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "webNavigation"
  ],

  "host_permissions": [
    "http://localhost:8000/*",
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "toast.js"
      ],
      "run_at": "document_start"
    }
  ],

  "options_page": "options.html",

  "action": {
    "default_title": "PhishGuard AI",
    "default_popup": "popup.html"
  }
}