<mxfile host="drawio"><diagram name="Detection pipeline"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="" style="ellipse;fillColor=#222222;strokeColor=#222222;html=1;" vertex="1" parent="1"><mxGeometry x="545" y="0" width="30" height="30" as="geometry"/></mxCell><mxCell id="c3" value="URL submitted (Scanner page or browser extension)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#3D4D5C;fontFamily=Arial;fontSize=14;align=center;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="350.0" y="60" width="420" height="44" as="geometry"/></mxCell><mxCell id="c4" value="Valid URL? (not empty, no spaces, at most 2,048 characters, not a local or private address)" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.06;fillColor=#FFF8E1;strokeColor=#3D4D5C;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="260" y="134" width="600" height="60" as="geometry"/></mxCell><mxCell id="c5" value="Validation message shown;&lt;br&gt;no scan is made" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#F2F2F2;strokeColor=#3D4D5C;fontFamily=Arial;fontSize=14;align=left;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="60" y="228" width="230" height="56" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;1.&lt;/b&gt; URL clean-up and canonicalisation; an address typed without&lt;br&gt;http:// or https:// is checked as https://" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#3D4D5C;fontFamily=Arial;fontSize=14;align=left;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="300.0" y="228" width="520" height="56" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;2.&lt;/b&gt; Redirect unwrapping: a Google, Outlook Safe Links or Facebook&lt;br&gt;redirect on a trusted service is checked by the address it opens" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#3D4D5C;fontFamily=Arial;fontSize=14;align=left;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="300.0" y="314" width="520" height="56" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;3.&lt;/b&gt; On the trusted allowlist? (no redirect to an untrusted site;&lt;br&gt;no user sites such as *.cloudapp.azure.com or *.netlify.com)" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.06;fillColor=#FFF8E1;strokeColor=#3D4D5C;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="260" y="400" width="600" height="64" as="geometry"/></mxCell><mxCell id="c9" value="Trusted Website&lt;br&gt;(model not used)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DFF0E0;strokeColor=#3D4D5C;fontFamily=Arial;fontSize=14;align=left;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="60" y="496" width="230" height="56" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;4.&lt;/b&gt; Stage 1: Random Forest gives P(phishing) from 22 URL features" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#3D4D5C;fontFamily=Arial;fontSize=14;align=left;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="300.0" y="496" width="520" height="44" as="geometry"/></mxCell><mxCell id="c11" value="Domain age found within 3 seconds?&lt;br&gt;(not shared hosting, a short link or an IP address)" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.06;fillColor=#FFF8E1;strokeColor=#3D4D5C;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="340" y="570" width="440" height="60" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;5.&lt;/b&gt; Stage 2: logistic regression on the stage-1 log-odds and&lt;br&gt;log(1 + domain age in days): &amp;ge; 0.66 Phishing,&lt;br&gt;0.40 to 0.66 Suspicious, &amp;lt; 0.40 Legitimate" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#3D4D5C;fontFamily=Arial;fontSize=14;align=left;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="660" y="660" width="450" height="76" as="geometry"/></mxCell><mxCell id="c13" value="Stage 2 skipped: stage-1 thresholds&lt;br&gt;&amp;ge; 0.89 Phishing, 0.73 to 0.89 Suspicious,&lt;br&gt;&amp;lt; 0.73 Legitimate (HTTPS-only check)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#F2F2F2;strokeColor=#3D4D5C;fontFamily=Arial;fontSize=14;align=left;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="120" y="660" width="360" height="76" as="geometry"/></mxCell><mxCell id="c14" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#3D4D5C;" vertex="1" parent="1"><mxGeometry x="540" y="760" width="40" height="40" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;6.&lt;/b&gt; Post-model rules: reputation cap, HTTP rule, reputable-site rule,&lt;br&gt;short-link rule and brand rule (look-alike, name or misspelling)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#3D4D5C;fontFamily=Arial;fontSize=14;align=left;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="280.0" y="826" width="560" height="56" as="geometry"/></mxCell><mxCell id="c16" value="Result still Suspicious?" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.06;fillColor=#FFF8E1;strokeColor=#3D4D5C;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="390" y="910" width="340" height="48" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;7.&lt;/b&gt; Live page check (HTML only, at most 6 s, 1 MB and 5 redirects):&lt;br&gt;a risk raises the result to Phishing; a page naming only its own&lt;br&gt;well-established website lowers it to Legitimate; a short link is&lt;br&gt;followed and its destination is checked again from step 2" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#3D4D5C;fontFamily=Arial;fontSize=14;align=left;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="350" y="986" width="560" height="96" as="geometry"/></mxCell><mxCell id="c18" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#3D4D5C;" vertex="1" parent="1"><mxGeometry x="540" y="1108" width="40" height="40" as="geometry"/></mxCell><mxCell id="c19" value="Save the detection and show the verdict with its reasons" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#3D4D5C;fontFamily=Arial;fontSize=14;align=center;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="330.0" y="1172" width="460" height="44" as="geometry"/></mxCell><mxCell id="c20" value="Explanation requested? (Scanner result page or&lt;br&gt;a Detection Logs record; not for extension scans)" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.06;fillColor=#FFF8E1;strokeColor=#3D4D5C;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="270" y="1244" width="580" height="60" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;8.&lt;/b&gt; /api/explain: plain-language reasons, attack-type analysis,&lt;br&gt;SHAP TreeExplainer and LIME contributions, evidence cards" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#3D4D5C;fontFamily=Arial;fontSize=14;align=left;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="290.0" y="1334" width="540" height="56" as="geometry"/></mxCell><mxCell id="c22" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#3D4D5C;" vertex="1" parent="1"><mxGeometry x="540" y="1416" width="40" height="40" as="geometry"/></mxCell><mxCell id="c23" value="" style="ellipse;shape=doubleEllipse;fillColor=#222222;strokeColor=#222222;html=1;" vertex="1" parent="1"><mxGeometry x="543" y="1484" width="34" height="34" as="geometry"/></mxCell><mxCell id="c24" value="SHAP and LIME are calculated only when an explanation is requested, not during the scan itself." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#3D4D5C;fontFamily=Arial;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="890" y="1324" width="250" height="84" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#3D4D5C;strokeWidth=1.5;fontFamily=Arial;fontSize=14;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#3D4D5C;strokeWidth=1.5;fontFamily=Arial;fontSize=14;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#3D4D5C;strokeWidth=1.5;fontFamily=Arial;fontSize=14;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#3D4D5C;strokeWidth=1.5;fontFamily=Arial;fontSize=14;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="175" y="164"/></Array></mxGeometry></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#3D4D5C;strokeWidth=1.5;fontFamily=Arial;fontSize=14;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="